# Aether Hub — cloud configuration
#
# Copy this file to `.env` and fill in your Supabase project values.
# Restart `npm run tauri:dev` (or rebuild) after changing them.
#
# 1. Create a free project at https://supabase.com
# 2. Open SQL Editor → paste supabase/schema.sql → Run.
# 3. Deploy the admin Edge Function (see README → Cloud setup).
# 4. Project Settings → API → copy URL + anon public key below.
# 5. On your Mac only, add the same long random string you set as the
#    ADMIN_TOKEN secret for the Edge Function. Never commit this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Creator builds only. Public/GitHub builds must leave this empty so the
# shipped app has no admin write access.
VITE_AETHER_ADMIN_TOKEN=
